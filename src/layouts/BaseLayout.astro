---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = '一个用 Astro 搭建、部署在 GitHub Pages 上的静态站点模板',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <nav>
        <a href={import.meta.env.BASE_URL}>首页</a>
        <a href={`${import.meta.env.BASE_URL}about/`}>关于</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p>用 Astro 构建 · 部署于 GitHub Pages</p>
    </footer>

    <style is:global>
      :root {
        color-scheme: dark;
        font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
        background: #0e1117;
        color: #e6edf3;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      header {
        border-bottom: 1px solid #30363d;
        padding: 1rem 1.5rem;
      }
      nav { display: flex; gap: 1.25rem; }
      nav a { color: #58a6ff; text-decoration: none; }
      nav a:hover { text-decoration: underline; }
      main {
        flex: 1;
        max-width: 720px;
        margin: 0 auto;
        padding: 3rem 1.5rem;
        width: 100%;
      }
      h1 { font-size: 2rem; line-height: 1.25; }
      footer {
        border-top: 1px solid #30363d;
        padding: 1.25rem 1.5rem;
        text-align: center;
        color: #8b949e;
        font-size: 0.875rem;
      }
    </style>
  </body>
</html>
